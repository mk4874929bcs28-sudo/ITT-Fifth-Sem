#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

int calculate(char* s) {
    int len = strlen(s);
    int* stack = (int*)malloc(len * sizeof(int));
    int top = -1;

    int result = 0;
    int sign = 1;

    int i = 0;
    while (i < len) {
        if (isdigit(s[i])) {
            long long num = 0;
            while (i < len && isdigit(s[i])) {
                num = num * 10 + (s[i] - '0');
                i++;
            }
            result += sign * num;
            i--; 
        } else if (s[i] == '+') {
            sign = 1;
        } else if (s[i] == '-') {
            sign = -1;
        } else if (s[i] == '(') {
            stack[++top] = result;
            stack[++top] = sign;
            result = 0;
            sign = 1;
        } else if (s[i] == ')') {
            int prev_sign = stack[top--];
            int prev_result = stack[top--];
            result = prev_result + prev_sign * result;
        }
        i++;
    }

    free(stack);
    return result;
}
