class Solution {
    public int maxSubarraySumCircular(int[] nums) {
        int totalSum = nums[0];
        int maxAccum = nums[0];
        int currentMax = nums[0];
        int minAccum = nums[0];
        int currentMin = nums[0];       
        for (int i = 1; i < nums.length; i++) {
            int x = nums[i];
            totalSum += x;           
            currentMax = Math.max(x, currentMax + x);
            maxAccum = Math.max(maxAccum, currentMax);            
            currentMin = Math.min(x, currentMin + x);
            minAccum = Math.min(minAccum, currentMin);
        }        
        if (maxAccum < 0) {
            return maxAccum;
        }       
        return Math.max(maxAccum, totalSum - minAccum);
    }
}
