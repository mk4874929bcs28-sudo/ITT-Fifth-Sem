import java.util.ArrayDeque;
import java.util.Deque;

class Solution {
    public int minimumCoins(int[] prices) {
        int n = prices.length;
        int[] dp = new int[n + 2];
        Deque<Integer> deque = new ArrayDeque<>();
        
        for (int i = n; i >= 1; i--) {
            while (!deque.isEmpty() && deque.peekFirst() > 2 * i + 1) {
                deque.pollFirst();
            }
            
            while (!deque.isEmpty() && dp[deque.peekLast()] >= dp[i + 1]) {
                deque.pollLast();
            }
            deque.addLast(i + 1);
            
            dp[i] = prices[i - 1] + dp[deque.peekFirst()];
        }
        
        return dp[1];
    }
}
