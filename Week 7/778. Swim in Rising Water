#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

typedef struct {
    int r, c, val;
} Cell;

typedef struct {
    Cell* data;
    int size;
    int capacity;
} MinHeap;

MinHeap* createMinHeap(int capacity) {
    MinHeap* heap = (MinHeap*)malloc(sizeof(MinHeap));
    heap->data = (Cell*)malloc(capacity * sizeof(Cell));
    heap->size = 0;
    heap->capacity = capacity;
    return heap;
}

void swap(Cell* a, Cell* b) {
    Cell temp = *a;
    *a = *b;
    *b = temp;
}

void push(MinHeap* heap, Cell cell) {
    heap->data[heap->size] = cell;
    int i = heap->size;
    heap->size++;
    
    while (i > 0 && heap->data[i].val < heap->data[(i - 1) / 2].val) {
        swap(&heap->data[i], &heap->data[(i - 1) / 2]);
        i = (i - 1) / 2;
    }
}

Cell pop(MinHeap* heap) {
    Cell root = heap->data[0];
    heap->size--;
    heap->data[0] = heap->data[heap->size];
    
    int i = 0;
    while (2 * i + 1 < heap->size) {
        int left = 2 * i + 1;
        int right = 2 * i + 2;
        int smallest = left;
        
        if (right < heap->size && heap->data[right].val < heap->data[left].val) {
            smallest = right;
        }
        if (heap->data[i].val <= heap->data[smallest].val) {
            break;
        }
        swap(&heap->data[i], &heap->data[smallest]);
        i = smallest;
    }
    return root;
}

int swimInWater(int** grid, int gridSize, int* gridColSize) {
    int n = gridSize;
    bool** visited = (bool**)malloc(n * sizeof(bool*));
    for (int i = 0; i < n; i++) {
        visited[i] = (bool*)calloc(n, sizeof(bool));
    }
    
    MinHeap* heap = createMinHeap(n * n);
    
    Cell start = {0, 0, grid[0][0]};
    push(heap, start);
    visited[0][0] = true;
    
    int dr[] = {-1, 1, 0, 0};
    int dc[] = {0, 0, -1, 1};
    int maxTime = 0;
    
    while (heap->size > 0) {
        Cell curr = pop(heap);
        
        if (curr.val > maxTime) {
            maxTime = curr.val;
        }
        
        if (curr.r == n - 1 && curr.c == n - 1) {
            // Clean up memory before returning
            for (int i = 0; i < n; i++) free(visited[i]);
            free(visited);
            free(heap->data);
            free(heap);
            return maxTime;
        }
        
        for (int i = 0; i < 4; i++) {
            int nr = curr.r + dr[i];
            int nc = curr.c + dc[i];
            
            if (nr >= 0 && nr < n && nc >= 0 && nc < n && !visited[nr][nc]) {
                visited[nr][nc] = true;
                Cell next = {nr, nc, grid[nr][nc]};
                push(heap, next);
            }
        }
    }
    
    return -1;
}
